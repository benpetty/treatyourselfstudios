---
import type { SiteSettings } from "../lib/sanity";
import Sprig from "./Sprig.astro";

interface Props {
  settings: SiteSettings;
}
const { settings } = Astro.props;
---
<p class="announcement">
  <Sprig />
  <span class="announcement-text">
    { settings.firstVisitOffer && <><span>{ settings.firstVisitOffer }</span><span aria-hidden="true">·</span></> }
    <a href={ `tel:${settings.phoneE164}` }>{ settings.phone }</a>
  </span>
  <Sprig mirrored />
</p>

<style>
  .announcement {
    display: flex; align-items: center; justify-content: center; gap: var(--space-3);
    margin: 0; padding: var(--space-2) var(--space-3);
    background: var(--color-espresso); color: var(--color-cream); font-size: var(--text-sm);
  }
  .announcement-text { display: flex; flex-wrap: wrap; justify-content: center; column-gap: var(--space-2); text-align: center; }
  .announcement a { color: inherit; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .announcement a:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
