---
import type { HomePage } from "../lib/sanity";
import { urlFor } from "../lib/image";

interface Props {
  homePage: HomePage;
  bookingUrl: string;
}
const { homePage, bookingUrl } = Astro.props;

const HERO_WIDTH = 1600;
const HERO_HEIGHT = 900;
const heroSrcsetWidths = [ 800, 1200, 1600 ];

function heroImageUrl( width: number ): string {
  if( !homePage.heroImage ) throw new Error( "heroImageUrl called without a hero image" );
  const height = Math.round( ( width * HERO_HEIGHT ) / HERO_WIDTH );
  return urlFor( homePage.heroImage ).width( width ).height( height ).fit( "crop" ).auto( "format" ).url();
}

const heroSrc = homePage.heroImage ? heroImageUrl( HERO_WIDTH ) : undefined;
const heroSrcset = homePage.heroImage
  ? heroSrcsetWidths.map( ( width ) => `${heroImageUrl( width )} ${width}w` ).join( ", " )
  : undefined;
---
<section class="hero">
  { homePage.heroImage && heroSrc && (
    <img
      class="hero-image"
      src={ heroSrc }
      srcset={ heroSrcset }
      sizes="100vw"
      alt={ homePage.heroImage.alt }
      width={ HERO_WIDTH }
      height={ HERO_HEIGHT }
      fetchpriority="high"
    />
  ) }
  { !homePage.heroImage && (
    <svg class="hero-rosette" viewBox="0 0 100 100" aria-hidden="true" fill="none" stroke="var(--color-terracotta-bright)" stroke-width="0.6">
      <circle cx="50" cy="50" r="8" />
      <path d="M50,20 C56,32 56,42 50,50 C44,42 44,32 50,20 Z" />
      <path d="M80,50 C68,56 58,56 50,50 C58,44 68,44 80,50 Z" />
      <path d="M50,80 C44,68 44,58 50,50 C56,58 56,68 50,80 Z" />
      <path d="M20,50 C32,44 42,44 50,50 C42,56 32,56 20,50 Z" />
      <path d="M71,29 C67,40 60,46 50,50 C54,40 61,33 71,29 Z" />
      <path d="M71,71 C60,67 54,60 50,50 C60,54 67,61 71,71 Z" />
      <path d="M29,71 C33,60 40,54 50,50 C46,60 39,67 29,71 Z" />
      <path d="M29,29 C40,33 46,40 50,50 C40,46 33,39 29,29 Z" />
    </svg>
  ) }
  <div class="hero-overlay">
    <div class="container hero-content">
      <h1>{ homePage.heroHeading }</h1>
      <p class="hero-subheading">{ homePage.heroSubheading }</p>
      <div class="hero-actions">
        <a class="button" href={ bookingUrl } rel="noopener">Book Now</a>
        <a class="button button--outline" href="/services/">View Services</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: clamp(24rem, 60vh, 38rem);
    background: linear-gradient(135deg, var(--color-moss-deep) 0%, var(--color-espresso) 60%, var(--color-espresso-warm) 100%);
    overflow: hidden;
  }
  .hero-rosette {
    position: absolute;
    left: 50%;
    top: 50%;
    width: clamp(20rem, 55vw, 34rem);
    height: auto;
    transform: translate(-50%, -50%);
    opacity: 0.22;
  }
  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-overlay {
    position: relative;
    display: grid;
    align-content: center;
    width: 100%;
    background: linear-gradient(rgb(59 47 42 / 0.55), rgb(59 47 42 / 0.35));
  }
  .hero:not(:has(.hero-image)) .hero-overlay {
    background: none;
  }
  .hero-content {
    width: 100%;
    padding-block: var(--space-6);
    text-align: center;
  }
  .hero-content h1 {
    margin: 0;
    font-size: var(--text-hero);
    color: var(--color-ivory);
  }
  .hero:not(:has(.hero-image)) .hero-subheading {
    color: var(--color-cream-muted);
  }
  .hero-subheading {
    max-width: 38rem;
    margin: var(--space-3) auto var(--space-5);
    font-size: var(--text-lg);
    color: var(--color-ivory);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
  /* The hero ground is dark in both states (gradient, or photo + overlay),
     so the outline button always takes the ivory treatment. */
  .hero-actions .button--outline {
    color: var(--color-ivory);
    box-shadow: inset 0 0 0 2px var(--color-ivory);
  }
  .hero-actions .button--outline:hover {
    background: var(--color-ivory);
    color: var(--color-espresso);
  }
</style>
