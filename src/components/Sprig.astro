---
// Original line-art sprig that draws itself in. Strokes use currentColor, so it
// inherits whatever text color surrounds it; `mirrored` flips it for a
// right-hand bookend.
interface Props {
  mirrored?: boolean;
}
const { mirrored = false } = Astro.props;
---
<svg class:list={ [ "sprig", { "sprig--mirrored": mirrored } ] } viewBox="0 0 24.2 35.8" aria-hidden="true" focusable="false">
  <path pathLength="100" style="--draw-delay: 0s" d="M11.78 35.3C10.78 28.3 11.78 20.3 13.78 13.3C14.78 9.3 14.98 6.3 13.78 3.8" />
  <path pathLength="100" style="--draw-delay: 0.5s" d="M13.78 3.8C12.38 2.9 12.58 1.1 13.78 0.5C14.98 1.2 15.08 3 13.78 3.8Z" />
  <path pathLength="100" style="--draw-delay: 1s" d="M14.18 9.3C17.85 8.6 21.53 5.45 22.93 1.6C18.73 1.95 15.23 5.1 14.18 9.3Z" />
  <path pathLength="100" style="--draw-delay: 1.5s" d="M13.38 15.3C9.18 14.95 4.98 11.8 3.23 7.25C7.78 7.25 11.8 10.58 13.38 15.3Z" />
  <path pathLength="100" style="--draw-delay: 2s" d="M12.68 20.8C17.4 20.45 21.95 16.95 23.7 12.22C18.63 12.22 14.26 15.73 12.68 20.8Z" />
  <path pathLength="100" style="--draw-delay: 2.5s" d="M11.88 26.8C6.98 26.62 2.25 22.95 0.5 17.87C5.75 18.05 10.13 21.73 11.88 26.8Z" />
</svg>

<style>
  .sprig {
    flex: none; width: auto; height: 2.6em;
    fill: none; stroke: currentColor; stroke-linejoin: round; stroke-linecap: round;
  }
  .sprig--mirrored { transform: scaleX(-1); }
  .sprig path {
    /* Fixed screen-pixel line: a viewBox-unit stroke would shrink below 1px at
       bar size and render mushy. */
    vector-effect: non-scaling-stroke; stroke-width: 1.25px;
    stroke-dasharray: 100; stroke-dashoffset: 100;
    animation: sprig-draw 2.5s ease-out var(--draw-delay) forwards;
  }
  @keyframes sprig-draw { to { stroke-dashoffset: 0; } }
  /* The global reduced-motion rule sets `animation: none`, which would leave the
     strokes stuck at their hidden starting offset — show them fully drawn instead. */
  @media (prefers-reduced-motion: reduce) {
    .sprig path { stroke-dashoffset: 0; }
  }
</style>
