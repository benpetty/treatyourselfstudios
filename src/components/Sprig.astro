---
// Original line-art sprig that draws itself in. Strokes use currentColor, so it
// inherits whatever text color surrounds it; `mirrored` flips it for a
// right-hand bookend.
interface Props {
  mirrored?: boolean;
}
const { mirrored = false } = Astro.props;
---
<svg class:list={ [ "sprig", { "sprig--mirrored": mirrored } ] } viewBox="0 0 16 26" aria-hidden="true" focusable="false">
  <path pathLength="100" style="--draw-delay: 0s" d="M6 25.5C5.2 21 6.4 16.5 8.6 12.6C10.2 9.8 10.8 7 10.2 4.4" />
  <path pathLength="100" style="--draw-delay: 0.6s" d="M10.2 4.4C8.9 3.4 8.8 1.6 10.1 0.6C11.5 1.5 11.6 3.4 10.2 4.4Z" />
  <path pathLength="100" style="--draw-delay: 1.4s" d="M8.9 12.1C11.2 12.2 13.6 10.6 14.8 8.1C12.3 7.8 9.9 9.6 8.9 12.1Z" />
  <path pathLength="100" style="--draw-delay: 2.2s" d="M7.1 17.2C4.6 17.6 2 16.1 0.8 13.6C3.4 13.1 6 14.6 7.1 17.2Z" />
  <path pathLength="100" style="--draw-delay: 3s" d="M6.3 21.6C7.9 20.4 10 20.3 11.6 21.3C10.1 22.6 7.9 22.7 6.3 21.6Z" />
</svg>

<style>
  .sprig {
    flex: none; width: auto; height: 1.4em;
    fill: none; stroke: currentColor; stroke-width: 1; stroke-linejoin: round; stroke-linecap: round;
  }
  .sprig--mirrored { transform: scaleX(-1); }
  .sprig path {
    stroke-dasharray: 100; stroke-dashoffset: 100;
    animation: sprig-draw 2.5s ease-out var(--draw-delay) forwards;
  }
  @keyframes sprig-draw { to { stroke-dashoffset: 0; } }
  /* The global reduced-motion rule sets `animation: none`, which would leave the
     strokes stuck at their hidden starting offset — show them fully drawn instead. */
  @media (prefers-reduced-motion: reduce) {
    .sprig path { stroke-dashoffset: 0; }
  }
</style>
