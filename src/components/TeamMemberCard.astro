---
import type { TeamMember } from "../lib/sanity";
import { urlFor } from "../lib/image";
import PortableText from "./PortableText.astro";

interface Props {
  member: TeamMember;
}
const { member } = Astro.props;

const PHOTO_WIDTH = 480;
const PHOTO_HEIGHT = 560;
const photoUrl = member.photo
  ? urlFor( member.photo ).width( PHOTO_WIDTH * 2 ).height( PHOTO_HEIGHT * 2 ).fit( "crop" ).auto( "format" ).url()
  : undefined;
---
<article class="team-member card">
  { photoUrl && member.photo && (
    <img
      class="team-member-photo"
      src={ photoUrl }
      alt={ member.photo.alt }
      width={ PHOTO_WIDTH }
      height={ PHOTO_HEIGHT }
      loading="lazy"
      decoding="async"
    />
  ) }
  <div class="team-member-bio">
    <h3 class="team-member-name">{ member.name }</h3>
    <p class="eyebrow team-member-role">{ member.role }</p>
    <PortableText value={ member.bio } />
  </div>
</article>

<style>
  .team-member {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    overflow: hidden;
  }
  @media (min-width: 42rem) {
    .team-member {
      grid-template-columns: minmax(14rem, 2fr) 3fr;
      gap: var(--space-5);
      padding: var(--space-5);
      align-items: start;
    }
  }
  .team-member-photo {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    object-fit: cover;
  }
  .team-member-name { margin-block: 0 var(--space-1); }
  .team-member-role { margin-block: 0 var(--space-3); }
  .team-member-bio :global(p) { color: var(--color-bark); }
  .team-member-bio :global(p:last-child) { margin-bottom: 0; }
</style>
