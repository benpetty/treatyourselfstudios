---
interface Props {
  giftCardUrl: string;
}
const { giftCardUrl } = Astro.props;
---
<div class="gift-callout">
  <img
    class="gift-callout-image"
    src="/images/gift-cards.jpg"
    alt="Champagne and roses set out on the lounge table at Treat YourSelf Studios"
    width="1200"
    height="1600"
    loading="lazy"
  />
  <div class="gift-callout-body">
    <p class="eyebrow">Gift Cards</p>
    <h2>Give the gift of self-care</h2>
    <p>
      Treat someone you love to a little time for themselves. Gift cards are available in any
      amount and can be used toward any of our services.
    </p>
    <a class="button" href={ giftCardUrl } rel="noopener">Buy a Gift Card</a>
  </div>
</div>

<style>
  .gift-callout {
    display: grid;
    overflow: hidden;
    position: relative;
    color: var(--color-cream);
  }
  .gift-callout-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-card);
  }
  .gift-callout-body {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: var(--space-3);
    padding: var(--space-5);
  }
  .gift-callout-body h2,
  .gift-callout-body p {
    margin: 0;
  }
  .gift-callout-body p {
    color: var(--color-cream-muted);
  }
  .gift-callout .eyebrow {
    color: var(--color-terracotta-bright);
  }
  .gift-callout .button {
    background: var(--color-terracotta-deep);
    color: var(--color-ivory);
  }
  .gift-callout .button:hover {
    background: var(--color-cream);
    color: var(--color-espresso);
  }
  @media (min-width: 48rem) {
    .gift-callout {
      grid-template-columns: 2fr 3fr;
    }
    .gift-callout-image {
      max-height: 26rem;
    }
  }
</style>
