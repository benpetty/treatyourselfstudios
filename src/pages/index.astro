---
import Layout from "../layouts/Layout.astro";
import CategoryCard from "../components/CategoryCard.astro";
import CurveDivider from "../components/CurveDivider.astro";
import DealBanner from "../components/DealBanner.astro";
import GiftCardCallout from "../components/GiftCardCallout.astro";
import Hero from "../components/Hero.astro";
import HoursLocation from "../components/HoursLocation.astro";
import PortableText from "../components/PortableText.astro";
import SucculentTexture from "../components/SucculentTexture.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import Ticker from "../components/Ticker.astro";
import {
  getDeals,
  getHomePage,
  getServiceCategories,
  getSiteSettings,
  getTestimonials,
} from "../lib/sanity";

const [ settings, homePage, categories, deals, testimonials ] = await Promise.all( [
  getSiteSettings(),
  getHomePage(),
  getServiceCategories(),
  getDeals(),
  getTestimonials(),
] );

const serviceCategories = categories.filter( ( category ) => !category.isAddOnCategory );
const featuredTestimonials = testimonials.slice( 0, 3 );
const pageTitle = `${homePage.seoTitle} | ${settings.siteTitle}`;
---
<Layout title={ pageTitle } description={ homePage.seoDescription } settings={ settings }>
  <Hero homePage={ homePage } bookingUrl={ settings.bookingUrl } />
  <Ticker settings={ settings } />

  <section class="section container welcome" aria-labelledby="welcome-heading">
    <p class="eyebrow">Welcome</p>
    <h2 id="welcome-heading">{ homePage.welcomeHeading }</h2>
    <div class="welcome-body">
      <PortableText value={ homePage.welcomeBody } />
    </div>
  </section>

  <section class="section container" aria-labelledby="services-heading">
    <p class="eyebrow">Our Services</p>
    <h2 id="services-heading">Explore Our Services</h2>
    <div class="category-grid">
      { serviceCategories.map( ( category ) => <CategoryCard category={ category } /> ) }
    </div>
  </section>

  <DealBanner deals={ deals } />

  <CurveDivider fill="var(--color-espresso)" direction="down" background="var(--color-blush)" />
  <section class="gift-band" aria-label="Gift cards">
    <SucculentTexture stroke="var(--color-terracotta)" />
    <div class="container gift-band-inner">
      <GiftCardCallout giftCardUrl={ settings.giftCardUrl } />
    </div>
  </section>
  {/* Bottom curve abuts the blush testimonial band when present, the cream body otherwise. */}
  <CurveDivider
    fill="var(--color-espresso)"
    direction="up"
    background={ featuredTestimonials.length > 0 ? "var(--color-blush)" : undefined }
  />

  { featuredTestimonials.length > 0 && (
    <section class="testimonial-band" aria-labelledby="testimonials-heading">
      <div class="container">
        <div class="rating-header">
          { settings.googleRating ? (
            <p class="rating-figure">
              <span class="rating-number">{ settings.googleRating.toFixed( 1 ) }</span>
              <span class="rating-stars" aria-hidden="true">★★★★★</span>
            </p>
          ) : (
            <p class="eyebrow">Kind Words</p>
          ) }
          <h2 id="testimonials-heading">What Clients Are Saying</h2>
          { settings.googleReviewUrl && (
            <a class="rating-link" href={ settings.googleReviewUrl } rel="noopener">Read our reviews on Google</a>
          ) }
        </div>
        <div class="testimonial-row">
          { featuredTestimonials.map( ( testimonial ) => <TestimonialCard testimonial={ testimonial } /> ) }
        </div>
      </div>
    </section>
  ) }

  <HoursLocation settings={ settings } />
</Layout>

<style>
  .welcome {
    max-width: 46rem;
    text-align: center;
  }
  .welcome .eyebrow,
  .welcome h2 {
    margin-block: 0 var(--space-3);
  }
  .welcome-body {
    color: var(--color-bark);
  }
  .eyebrow {
    margin-block: 0 var(--space-1);
  }
  section h2 {
    margin-block: 0 var(--space-4);
  }
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-4);
  }
  .testimonial-band { background: var(--color-blush); padding-block: var(--space-6); }
  .rating-header { text-align: center; margin-block-end: var(--space-4); }
  .rating-figure { margin: 0; font-family: var(--font-display); font-size: var(--text-2xl); color: var(--color-espresso); }
  .rating-stars { color: var(--color-terracotta); margin-inline-start: var(--space-2); }
  .rating-link { font-size: var(--text-sm); }
  .testimonial-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-4);
  }
  .gift-band {
    position: relative;
    background: var(--color-espresso);
    padding-block: var(--space-5);
  }
  .gift-band-inner {
    position: relative;
  }
</style>
