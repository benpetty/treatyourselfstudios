---
import PackageCard from "../components/PackageCard.astro";
import ServiceRow from "../components/ServiceRow.astro";
import Layout from "../layouts/Layout.astro";
import { getDeals, getServicePackages, getServicesByCategory, getSiteSettings } from "../lib/sanity";

const [ settings, servicePackages, addOnServices, deals ] = await Promise.all( [
  getSiteSettings(),
  getServicePackages(),
  getServicesByCategory( "add-ons" ),
  getDeals(),
] );

const pageTitle = "Spa Packages & Deals in Seattle | Treat YourSelf Studios";
const pageDescription =
  "Bundled spa packages, service add-ons, and standing deals at Treat YourSelf Studios in Seattle. Book any service you'd like, for any human you'd like.";
---
<Layout title={ pageTitle } description={ pageDescription } settings={ settings }>
  <div class="container">
    <header class="page-header">
      <h1>Packages &amp; Deals</h1>
    </header>

    <section id="packages" class="section anchor-section" aria-labelledby="packages-heading">
      <h2 id="packages-heading">Packages</h2>
      <p class="section-intro">
        Our packages pair treatments that were made for each other, so you can settle in and stay a while.
        And don't let the names fool you — package names are just names. Feel free to book any service
        you'd like, for any human you'd like.
      </p>
      <div class="package-grid">
        { servicePackages.map( ( servicePackage ) => <PackageCard servicePackage={ servicePackage } /> ) }
      </div>
    </section>

    <section id="add-ons" class="section anchor-section" aria-labelledby="add-ons-heading">
      <h2 id="add-ons-heading">Service Add-Ons</h2>
      <p class="section-intro">Add any of these to a facial or body treatment.</p>
      <div class="add-on-list">
        { addOnServices.map( ( service ) => <ServiceRow service={ service } /> ) }
      </div>
    </section>

    <section id="deals" class="section anchor-section" aria-labelledby="deals-heading">
      <h2 id="deals-heading">Standing Deals</h2>
      <div class="deal-grid">
        { deals.map( ( deal ) => (
          <article class="card deal-card">
            <h3 class="deal-card__title">{ deal.title }</h3>
            <p class="deal-card__details">{ deal.details }</p>
            { deal.finePrint && <p class="deal-card__fine-print">{ deal.finePrint }</p> }
          </article>
        ) ) }
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-header {
    padding-block-start: var(--space-6);
  }
  .page-header h1 {
    margin: 0;
  }
  .anchor-section {
    scroll-margin-top: var(--space-6);
  }
  .anchor-section h2 {
    margin-block: 0 var(--space-3);
  }
  .section-intro {
    max-width: 46rem;
    margin-block: 0 var(--space-4);
    color: var(--color-bark);
  }
  .package-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 48rem) {
    .package-grid {
      grid-template-columns: repeat( 2, 1fr );
    }
  }
  .add-on-list {
    max-width: 46rem;
  }
  .deal-grid {
    display: grid;
    grid-template-columns: repeat( auto-fit, minmax( 16rem, 1fr ) );
    gap: var(--space-4);
  }
  .deal-card {
    padding: var(--space-4);
    border-top: 4px solid var(--color-terracotta);
  }
  .deal-card__title {
    margin: 0;
  }
  .deal-card__details {
    margin: var(--space-2) 0 0;
  }
  .deal-card__fine-print {
    margin: var(--space-2) 0 0;
    font-size: var(--text-xs);
    color: var(--color-bark);
    font-style: italic;
  }
</style>
